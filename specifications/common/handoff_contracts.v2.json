      ]
    },
    "conclusion_to_playwright_revision_result": {
      "message_type": "revision_result",
      "sender": "conclusion.manager",
      "receiver": "playwright.manager",
      "required_payload": [
        "schema_version",
        "revision_result_id",
        "revision_request_id",
        "request_message_id",
        "workflow_id",
        "revision_epoch",
        "status",
        "base_artifacts",
        "result_artifacts",
        "finding_dispositions",
