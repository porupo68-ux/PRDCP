      "required_payload": [
        "schema_version",
        "revision_result_id",
        "revision_request_id",
        "request_message_id",
        "workflow_id",
        "revision_epoch",
        "status",
        "base_artifacts",
        "result_artifacts",
        "finding_dispositions",
        "idempotency_key"
      ]
    },
    "conclusion_to_deliberation_revision_request": {
      "message_type": "revision_request",
      "sender": "conclusion.manager",
      "receiver": "deliberation.manager",
      "required_payload": [
        "schema_version",
        "revision_request_id",
        "workflow_id",
        "route",
        "source_layer",
        "target_layer",
        "revision_epoch",
        "source_review_id",
        "source_finding_ids",
        "base_artifacts",
        "required_actions",
        "acceptance_conditions",
        "idempotency_key"
      ]
    },
    "deliberation_to_conclusion_revision_result": {
      "message_type": "revision_result",
      "sender": "deliberation.manager",
      "receiver": "conclusion.manager",
      "required_payload": [
        "schema_version",
        "revision_result_id",
        "revision_request_id",
        "request_message_id",
        "workflow_id",
        "revision_epoch",
        "status",
        "base_artifacts",
        "result_artifacts",
        "finding_dispositions",
        "idempotency_key"
      ]
    },
    "playwright_to_conclusion_revision_request": {
      "message_type": "revision_request",
      "sender": "playwright.manager",
      "receiver": "conclusion.manager",
      "required_payload": [
        "schema_version",
        "revision_request_id",
        "workflow_id",
        "route",
        "source_layer",
        "target_layer",
        "revision_epoch",
        "source_review_id",
        "source_finding_ids",
        "base_artifacts",
