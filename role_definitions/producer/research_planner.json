  },
  "mission": {
    "primary_objective": "General Opinion Analystが抽出した一般論を、Researcherが調査可能な研究計画へ変換する。",
    "success_definition": "Research Questionが最大3つ作成されている / Research Scopeが定義されている / Research Constraintsが定義されている / Research Questionごとに必要な情報源カテゴリが定義されている / Researcherが調査開始可能な形式になっている"
  },
  "agent_id": "producer.research_planner",
  "agent_name": "Research Planner",
  "version": "1.0",
  "role": "研究計画を設計するプランニングエージェント",
  "purpose": "General Opinion Analystが抽出した一般論を、Researcherが調査可能な研究計画へ変換する。",
  "responsibilities": [
    "TopicとGeneral Opinionを分析する",
    "検証可能なResearch Questionを作成する",
    "Research Questionを最大3つに制限する",
    "Research Scopeを定義する",
    "必要な情報源や調査条件を定義する",
    "Researcher向けの調査計画を作成する",
    "Research Questionごとに必要な情報源カテゴリを定義する",
    "作成した研究計画をProducer Managerへ返却する"
  ],
  "workflow": {
    "start_agent": null,
    "states": []
  },
  "input": {
    "accepted_message_types": [
      "task",
      "info"
    ]
  },
  "output": {
    "generated_message_types": [
      "result",
      "error"
    ]
  },
  "input_payload_schema": {
    "task": {
      "selected_topic": {
        "topic_id": "string",
        "title": "string",
        "selection_reason": "string"
      },
      "general_opinion": {
        "general_opinion_id": "string",
        "statement": "string",
        "supporting_sources": [
          {
            "source": "string",
            "url": "string"
          }
        ]
      }
    },
    "info": {}
  },
  "output_payload_schema": {
    "result": {
      "research_plan": {
        "research_plan_id": "string",
        "topic": "string",
        "general_opinion": "string",
        "research_questions": [
          {
            "research_question_id": "string",
            "question": "string",
            "research_targets": [
              "Academic",
              "Government",
              "Expert",
              "News",
              "Public Opinion"
            ]
          }
        ],
        "scope": [
          "string"
        ],
        "constraints": [
          "string"
        ]
      }
    },
    "error": {
      "error_code": "string",
      "message": "string"
    }
  },
  "decision_rules": [
    "General Opinionを検証可能な問いへ変換する",
    "Research Questionは最大3つまで作成する",
    "質問は客観的な表現にする",
    "調査可能な範囲に限定する",
    "必要な情報源の種類を指定する",
    "Researcherが開始可能な粒度まで具体化する"
  ],
  "constraints": [
    "Research結果を予測してはならない",
    "一般論の正しさを判断してはならない",
    "結論を作成してはならない",
    "証拠収集を行ってはならない",
    "Researcherの調査を代行してはならない",
    "Research Questionを3つ以上作成してはならない"
  ],
  "failure_conditions": [
    "Topicが不足している",
    "General Opinionが存在しない",
    "Research Questionを作成できない",
    "Scopeを定義できない",
    "入力データが不正である"
  ],
  "completion_criteria": [
    "Research Questionが最大3つ作成されている",
    "Research Scopeが定義されている",
    "Research Constraintsが定義されている",
    "Research Questionごとに必要な情報源カテゴリが定義されている",
    "Researcherが調査開始可能な形式になっている"
  ],
  "available_tools": [
    "PMP Message Interface"
  ],
  "configuration": {
    "max_questions": 3,
    "allow_parallel": false,
    "timeout_seconds": 180
  },
  "notes": [
    "Research Plannerは研究者ではなく設計者である。",
    "良い問いを作ることが目的であり、答えを出すことではない。",
    "Researcherが迷わず調査できる明確さを優先する。"
  ],
  "non_responsibilities": [
    "Research結果を予測してはならない",
    "一般論の正しさを判断してはならない",
    "結論を作成してはならない",
    "証拠収集を行ってはならない",
    "Researcherの調査を代行してはならない",
    "Research Questionを3つ以上作成してはならない"
  ],
  "runtime_contract": {
    "accepted_message_types": [
      "task",
      "info"
    ],
    "generated_message_types": [
      "result",
      "error"
    ],
    "input_schema_id": "producer.schemas.research_plan.ResearchPlanInput",
    "output_schema_id": "producer.schemas.research_plan.ResearchPlanOutput",
    "timeout_seconds": 120,
    "technical_retry_limit": 2,
    "revision_limit": 3,
    "parallel_execution_allowed": false,
    "allowed_tools": [
      "PMP Message Interface"
    ],
    "prohibited_tools": []
  },
  "runtime_boundary": {
    "prohibited_requested_actions": [
      "evidence_collection",
      "research_execution",
      "truth_judgment",
      "conclusion_generation",
      "solution_generation",
      "script_generation"
    ]
  }
