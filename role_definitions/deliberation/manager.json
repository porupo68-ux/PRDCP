    "retry_and_termination_policy": {
      "retry_counter_scope": "per_task",
      "default_retry_limit": 2,
      "retry_conditions": [
        "Schema違反",
        "必須項目欠落",
        "明示された指示への不適合",
        "既存入力の見落とし",
        "修正可能な論理的不整合"
      ],
      "non_retry_conditions": [
        "入力証拠そのものが不足している",
        "Researcherへの追加調査が必要である",
        "テーマ上解消不能な不確実性である",
        "同じ原因による失敗が上限回数発生している",
        "応答途中切断などProvider完了状態が不明な通信障害（自動retry禁止、明示的一回承認のみ）"
      ],
      "termination_conditions": [
        "Quality Reviewerがapprovedと判定した",
        "人間へのエスカレーションが必要になった",
        "再実行上限に達した",
        "上流入力の重大な欠陥によって処理継続不能となった"
      ]
    },
