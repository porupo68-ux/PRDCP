  "_design_notes": {
    "stable_decisions": [
      "Deliberation ManagerはDeliberation層の統括Agentである。",
      "Managerは専門Agentの分析を全面的に代行しない。",
      "DeliberationはResearcherの証拠に拘束される。",
      "Deliberationは最終結論および最終解決策を選択しない。",
      "一次専門分析は原則として並列実行する。",
      "Counterargument Analystは一次分析後に実行する。",
      "Managerによる統合後、Quality Reviewerの審査を必須とする。",
      "主要分析はevidence_idまで追跡可能にする。",
      "Conclusionへ渡す分析視点は最大3件とする。",
      "Agent間通信にはPMPを使用する。"
    ],
    "potentially_changeable": [
      {
        "item": "role_definition_schema_version",
        "current_value": "0.1.0",
        "reason": "他AgentのRD作成後に共通フィールドを追加する可能性がある。"
      },
      {
        "item": "default_retry_limit",
        "current_value": 2,
        "reason": "実際のAPI費用、失敗率および品質改善幅を測定後に調整する。"
      },
      {
        "item": "maximum_analysis_perspectives",
        "current_value": 3,
        "reason": "Conclusionおよび動画構成の設計によって変更される可能性がある。"
      },
      {
        "item": "dynamic_task_generation",
        "current_value": true,
        "reason": "v1実装では安定性を優先し、固定タスクだけに限定する可能性がある。"
      },
      {
        "item": "minor_web_search_permission",
        "current_value": false,
        "reason": "軽微な事実確認をDeliberationへ許可する案はあるが、Researcherとの責務境界が崩れる危険がある。"
      },
      {
        "item": "quality_reviewer_authority",
        "current_value": "blocking_gate",
        "reason": "Quality Reviewerを助言役とし、Managerを最終承認者に変更する可能性がある。"
      },
      {
        "item": "approved_with_warnings_route",
        "current_value": "not_defined",
        "reason": "軽微な警告を残したままConclusionへ進める運用を許可するか未決定である。"
      },
      {
        "item": "human_escalation_point",
        "current_value": "exception_only",
        "reason": "Conclusionへの引き渡し前に人間承認を必須化する可能性がある。"
      },
      {
        "item": "PMP_version",
        "current_value": "2.0",
        "reason": "Schema識別、親子メッセージ、相関ID、改訂管理の追加によりPMP 2.0へ移行済みである。"
      },
      {
        "item": "manager_model",
        "current_value": null,
        "reason": "長文統合能力、構造化出力精度、コンテキスト長、API価格を比較してAgent_Listで決定する。"
      }
    ],
    "known_compatibility_requirements": [
      {
        "target": "Researcher",
        "requirement": "Researcher Resultには一意なevidence_id、source_id、research_question_id、引用位置、品質評価および証拠の限界が必要である。"
      },
      {
        "target": "Conclusion",
        "requirement": "Conclusion ManagerはDeliberation Resultの分析視点、trade-off、不確実性および未解決問題を受け取れる必要がある。"
      },
      {
        "target": "PMP",
        "requirement": "現行PMPで基本通信は可能だが、task_id、schema_id、parent_message_id等の追加が望ましい。"
      },
      {
        "target": "Quality Reviewer",
        "requirement": "Quality Reviewerは統合結果だけでなく、専門Agentの元出力とResearcher Resultも参照できる必要がある。"
      }
    ]
  }
