  "_design_notes": {
    "stable_decisions": [
      "Argument Analystは一般論と証拠群を論証構造へ変換する専門Agentである。",
      "中心主張、副主張、前提、論拠、限定条件および例外を区別する。",
      "主要分析をclaim_id、evidence_id、source_idおよびresearch_question_idへ追跡可能にする。",
      "暗黙の前提と論拠は推定として明示する。",
      "事実、情報源の主張、Agentの推論および価値判断を分離する。",
      "支持、矛盾、限定、背景化、証拠不足および評価不能を区別する。",
      "証拠の対象範囲と主張の対象範囲を比較する。",
      "証拠品質の一次評価はResearcherの責務として維持する。",
      "詳細な因果モデルはCausal & Structural Analystへ委ねる。",
      "最終的な真偽、結論または解決策を決定しない。",
      "他レイヤーおよび他専門Agentとの通信はDeliberation Managerを経由する。"
    ],
    "potentially_changeable": [
      {
        "item": "argument_model",
        "current_value": "extended_toulmin_inspired_structure",
        "reason": "長い社会的論証で不十分な場合、argument_graph、issue_mappingまたはWalton型argumentation schemeを部分導入する可能性がある。"
      },
      {
        "item": "warrant_extraction",
        "current_value": "required_when_identifiable",
        "reason": "暗黙の論拠復元はモデル誤差が大きいため、v1実装では任意項目または高重要度主張だけに限定する可能性がある。"
      },
      {
        "item": "claim_type_taxonomy",
        "current_value": [
          "descriptive",
          "causal",
          "predictive",
          "normative",
          "definitional",
          "comparative",
          "mixed"
        ],
        "reason": "実際のテーマで分類重複が多い場合、primary_typeとsecondary_types方式へ変更する可能性がある。"
      },
      {
        "item": "epistemic_labels",
        "current_value": [
          "fact",
          "reported_claim",
          "inference",
          "causal_hypothesis",
          "scenario",
          "value_judgment",
          "uncertain"
        ],
        "reason": "ResearcherおよびConclusionの分類体系と統一する可能性がある。"
      },
      {
        "item": "support_status",
        "current_value": [
          "well_supported",
          "partially_supported",
          "mixed",
          "weakly_supported",
          "unsupported",
          "contradicted",
          "undetermined"
        ],
        "reason": "LLMによる段階評価が不安定な場合、支持・混合・不十分の3段階程度へ簡略化する可能性がある。"
      },
      {
        "item": "confidence_scale",
        "current_value": [
          "high",
          "medium",
          "low",
          "undetermined"
        ],
        "reason": "Researcherの証拠品質尺度およびQuality Reviewerの評価尺度と統一する必要がある。"
      },
      {
        "item": "mixed_claim_type",
        "current_value": "allowed",
        "reason": "mixedが過剰使用される場合は原則禁止し、必ず複数主張へ分解する可能性がある。"
      },
      {
        "item": "argument_graph_storage",
        "current_value": "nested_claim_structure",
        "reason": "複数の親を持つ主張や循環的議論を表現するため、nodes-and-edges形式へ変更する可能性がある。"
      },
      {
        "item": "evidence_relationship_cardinality",
        "current_value": "many_to_many",
        "reason": "実装と可視化を簡略化するため、一つのrelationshipを一つのclaim segmentに限定する可能性がある。"
      },
      {
        "item": "logical_gap_taxonomy",
        "current_value": "detailed",
        "reason": "分類精度が低い場合はunsupported_transition、scope_mismatch、ambiguityの三分類へ縮小する可能性がある。"
      },
      {
        "item": "direct_access_to_causal_analyst",
        "current_value": false,
        "reason": "レイテンシ削減のためAgent間の直接通信を許可する案はあるが、PMP履歴とManager統制が複雑化する。"
      },
      {
        "item": "default_retry_limit",
        "current_value": 2,
        "reason": "実装後の修正成功率、API費用および処理時間を測定して調整する。"
      },
      {
        "item": "argument_analyst_model",
        "current_value": null,
        "reason": "論証分解精度、長文処理能力、JSON出力安定性および価格を比較してAgent_Listで決定する。"
      }
    ],
    "known_compatibility_requirements": [
      {
        "target": "Researcher",
        "requirement": "各証拠には一意なevidence_id、source_id、research_question_id、引用位置、証拠品質、対象範囲および限界が必要である。"
      },
      {
        "target": "Deliberation Manager",
        "requirement": "Managerは共有定義、分析範囲、完了条件および対象evidence_idを明示してタスクを割り当てる必要がある。"
      },
      {
        "target": "Causal & Structural Analyst",
        "requirement": "causal claim、causal assumption、candidate warrantおよびcorrelation-causation gapをclaim_id単位で受け取れる必要がある。"
      },
      {
        "target": "Counterargument Analyst",
        "requirement": "重要主張、論拠、前提、反対証拠、例外およびlogical gapを参照できる必要がある。"
      },
      {
        "target": "Quality Reviewer",
        "requirement": "Argument Analysis ResultとResearcher Resultを比較し、未支持推論および参照不整合を検査できる必要がある。"
      },
      {
        "target": "PMP",
        "requirement": "現行PMPで通信可能だが、task_id、schema_id、analysis_idおよびparent_message_idの追加が望ましい。"
      }
    ],
    "cross_analysis_alignment_policy": {
      "matching_priority": [
        "research_question_id",
        "evidence_id",
        "semantic_similarity",
        "shared_definition",
        "time_scope",
        "geographic_scope"
      ]
    }
  }
}
