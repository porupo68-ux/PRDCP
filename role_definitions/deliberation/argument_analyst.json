        "evidence_relationship_count",
        "unsupported_claim_count",
        "contradicted_claim_count",
        "logical_gap_count",
        "scope_mismatch_count",
        "research_gap_count",
        "traceability_rate",
        "retry_count"
      ],
      "logging_constraints": [
        "内部の逐語的推論過程を記録せず、構造化された判断結果と参照根拠だけを記録する",
        "APIキー、認証情報および不要な個人情報を記録しない",
        "証拠本文全体ではなくevidence_id、必要な該当箇所および要約を使用する",
        "推定された前提や論拠を情報源の直接引用として記録しない"
      ]
    },
