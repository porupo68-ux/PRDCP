      "status_values": [
        "explicitly_stated",
        "inferred_from_argument",
        "partially_supported",
        "unsupported",
        "disputed",
        "unknown"
      ],
      "rules": [
        "暗黙の前提を原文の主張として引用しない",
        "推定前提には推定理由を記録する",
        "主張成立に必須でない背景知識を必須前提として扱わない",
