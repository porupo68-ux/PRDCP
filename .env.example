# Discordを使用する場合だけ設定してください。
DISCORD_BOT_TOKEN=

# APIなしの確認はmock、実運用時だけopenrouterへ変更します。
PRDCP_PROVIDER=mock
PRDCP_RD_RELOAD=false
PRDCP_RD_STRICT=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouterの実際のモデルIDは利用時点のIDを指定してください。
MODEL_PRODUCER_MANAGER=moonshotai/kimi-k3
MODEL_PRODUCER_TOPIC_SCOUT=perplexity/sonar
MODEL_PRODUCER_TOPIC_SELECTOR=moonshotai/kimi-k3
MODEL_PRODUCER_GENERAL_OPINION_ANALYST=perplexity/sonar-deep-research
MODEL_PRODUCER_RESEARCH_PLANNER=perplexity/sonar-pro
MODEL_PRODUCER_QUALITY_REVIEWER=moonshotai/kimi-k3
MODEL_RESEARCHER_MANAGER=moonshotai/kimi-k3
MODEL_RESEARCHER_EXPERT=perplexity/sonar-deep-research
MODEL_RESEARCHER_ACADEMIC=perplexity/sonar-deep-research
MODEL_RESEARCHER_GOVERNMENT=perplexity/sonar-deep-research
MODEL_RESEARCHER_NEWS=perplexity/sonar
MODEL_RESEARCHER_PUBLIC_OPINION=perplexity/sonar
MODEL_RESEARCHER_POLITICIAN=perplexity/sonar-deep-research
MODEL_RESEARCHER_INDUSTRY=perplexity/sonar-deep-research
MODEL_RESEARCHER_QUALITY_REVIEWER=moonshotai/kimi-k3
MODEL_DELIBERATION_MANAGER=moonshotai/kimi-k3
MODEL_DELIBERATION_ARGUMENT=deepseek/deepseek-r1
MODEL_DELIBERATION_CAUSAL_STRUCTURAL=deepseek/deepseek-r1
MODEL_DELIBERATION_STAKEHOLDER_RESPONSE=deepseek/deepseek-r1
MODEL_DELIBERATION_COUNTERARGUMENT=deepseek/deepseek-r1
MODEL_DELIBERATION_QUALITY_REVIEWER=openai/gpt-5.5
MODEL_CONCLUSION_MANAGER=qwen/qwen3.5-flash-02-23
MODEL_CONCLUSION_POSITION_GENERATOR=qwen/qwen3.5-flash-02-23
MODEL_CONCLUSION_DECISION_EVALUATOR=qwen/qwen3.6-35b-a3b
MODEL_CONCLUSION_DECISION_INTEGRATOR=qwen/qwen3.6-35b-a3b
MODEL_CONCLUSION_QUALITY_REVIEWER=qwen/qwen3.6-35b-a3b
MODEL_PLAYWRIGHT_MANAGER=moonshotai/kimi-k2.5
MODEL_PLAYWRIGHT_NARRATIVE_ARCHITECT=~google/gemini-flash-latest
MODEL_PLAYWRIGHT_SCRIPTWRITER=~anthropic/claude-sonnet-latest
MODEL_PLAYWRIGHT_EVIDENCE_CITATION_EDITOR=openai/gpt-5-mini
MODEL_PLAYWRIGHT_VISUAL_DIRECTOR=z-ai/glm-4.5-air

# falseなら各LayerのDiscordコマンドで手動起動します。
PRDCP_AUTO_START_RESEARCHER=false
PRDCP_AUTO_START_DELIBERATION=false
PRDCP_AUTO_START_CONCLUSION=false
PRDCP_AUTO_START_PLAYWRIGHT=false

PLAYWRIGHT_TARGET_DURATION_SECONDS=720
PLAYWRIGHT_MAX_REVISIONS=2
PLAYWRIGHT_MAX_TITLE_CANDIDATES=5
PLAYWRIGHT_MAX_THUMBNAIL_CANDIDATES=5
PLAYWRIGHT_REQUIRE_ALL_CITATIONS=true

# 空なら ./storage/data を使用します。
PRDCP_DATA_DIR=
PRDCP_LOG_LEVEL=INFO
